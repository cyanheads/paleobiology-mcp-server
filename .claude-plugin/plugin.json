  "mcpServers": {
    "paleobiology-mcp-server": {
      "command": "npx",
      "args": ["-y", "paleobiology-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
