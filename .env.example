# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # stateless | stateful | auto (default: auto, which resolves to stateful).
                                    # This server holds no per-session state; the Dockerfile pins stateless.

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Paleobiology Database (PBDB) ─────────────────────────────────────
# PBDB is keyless — no API key required.
# PBDB_BASE_URL=https://paleobiodb.org/data1.2   # API base; override for a mirror/proxy
# PBDB_TIMEOUT_MS=30000                           # Per-request timeout (diversity queries can be slow)
# PBDB_MAX_OCCURRENCES=1000                        # Hard cap on rows pulled per occurrence/collection call

# ── DataCanvas (analytical SQL over staged occurrences) ──────────────
# Set to duckdb to enable the spill path + paleobiology_dataframe_* tools.
# When unset, paleobiology_search_occurrences still returns its inline preview,
# but emits no usable canvas_id and the dataframe_* tools fail with a clear error.
# Requires the @duckdb/node-api optional peer dep (already in dependencies).
# CANVAS_PROVIDER_TYPE=duckdb

# Register paleobiology_dataframe_drop (off by default — absent from tools/list when unset).
# PALEOBIOLOGY_DATAFRAME_DROP_ENABLED=false
